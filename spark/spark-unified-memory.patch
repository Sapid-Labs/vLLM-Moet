+                                   args[-1] if args else None)
+            with _EAGER_LOCK:
+                if done["built"]:
+                    logger.warning(
+                        "moe_w2 eager: loader call AFTER build! layer=%s "
+                        "pname=%s args=%r kwargs=%r", done.get("key"),
+                        pname, args[:3], list(kwargs))
